# Local / VPS only. Do not commit.
GHL_API_KEY=
GHL_LOCATION_ID=V90iyFBbBrCg3tpctRjc
PORT=3847
# Default listen is 127.0.0.1 (nginx and the tunnel already proxy this port).
# Set 0.0.0.0 only if something still calls the raw public port.
BIND_HOST=127.0.0.1
# Empty = built-in list:
# https://aubaineexpress.voyagefiesta.ca
# https://www.aubaineexpress.voyagefiesta.ca
# https://voyagefiesta.com
# https://www.voyagefiesta.com
# https://promofiesta.roymarketing.ca
# localhost and 127.0.0.1 (any port) are always allowed.
# Production currently uses ALLOWED_ORIGINS=* ; leave that line in place
# on the VPS unless you intentionally replace it.
ALLOWED_ORIGINS=
GHL_CONTACT_TAG=reservation-site
GHL_PRICE_REQUEST_TAG=demande-prix
GHL_PRE_SALE_REQUEST_TAG=demande-prevente
GHL_QUICKFORM_TAG=quickform
GHL_GROUPE_TAG=demande-groupe
# 0 = no internal email for demande_groupe. 1 = send to INTERNAL_NOTIFY_EMAILS.
GHL_GROUPE_NOTIFY=0
# Used only when the contact has no owner. Empty = leave unassigned.
GHL_GROUPE_DEFAULT_OWNER=
# 1 = return the contact, tags and note without calling GoHighLevel.
DRY_RUN=0
GROUPES_JSON_PATH=
# Atrium sync (read by server/atrium-sync, same file on the VPS).
ATRIUM_API_KEY=
ATRIUM_API_BASE=https://api.groupeatrium.com/v3
ATRIUM_OUTPUT=
INTERNAL_NOTIFY_EMAILS=
GHL_EMAIL_FROM=info@promo.voyagefiesta.com
# Tests only. Refuses any URL on leadconnectorhq.com.
GHL_BLOCK_LIVE=0
GHL_TAG_DELAY_MS=900
